# ChoreMate environment (Vercel + local)

# REQUIRED — public site URL, no trailing slash
# After Vercel deploy, set this to your production URL, e.g. https://choremate.vercel.app
NEXT_PUBLIC_SITE_URL=https://YOUR_PRODUCTION_DOMAIN

# REQUIRED — Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# REQUIRED — server-only. Never expose in the browser / never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# REQUIRED — 32+ character secret used to sign child sessions
CHILD_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
